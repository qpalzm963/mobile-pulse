// 僅供 wrangler CLI 在本機套用 migration 使用（npm run db:migrate:local）。
//
// 刻意不放在專案根目錄、也刻意不叫 wrangler.jsonc：@cloudflare/vite-plugin 會
// 自動探索根目錄的 wrangler 設定並與 vite.config.ts 的 inline 設定合併，那會讓
// 同一組 binding 有兩個真相來源。放在這裡 plugin 看不到，只有顯式 -c 才會載入。
//
// 下面三個值必須與 vite.config.ts 的 localBindingConfig 一致，改一邊要改兩邊。
{
  "name": "mobile-pulse-local-d1",
  "compatibility_date": "2024-10-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000",
      // 相對於本設定檔所在目錄，指向 drizzle-kit 產出的 migration 目錄。
      "migrations_dir": "../drizzle"
    }
  ]
}
