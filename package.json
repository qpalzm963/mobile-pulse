{
  "name": "mobile-pulse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3000",
    "dev:web": "next dev --webpack -H 0.0.0.0 -p 3000",
    "dev:workbench": "npm --prefix apps/workbench run dev",
    "build": "next build --webpack",
    "build:workbench": "npm --prefix apps/workbench run build",
    "start": "next start -H 0.0.0.0",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:api-client": "vitest run --config packages/api-client/vitest.config.ts",
    "test:all": "node --test tests/*.test.mjs && vitest run && vitest run --config packages/api-client/vitest.config.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "fumadocs-core": "^16.15.0",
    "fumadocs-ui": "^16.15.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.33.0",
    "next": "^16.2.6",
    "payload": "^3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "^4.4.3",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "4.1.10"
  },
  "type": "module"
}
