{
  "name": "mobile-pulse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test tests/*.test.mjs && vitest run",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "video:create": "node scripts/generate-video-script.mjs",
    "video:preview": "npx remotion preview remotion/index.ts",
    "video:render": "npx remotion render remotion/index.ts ShortVideoVertical out/video-vertical.mp4",
    "video:render:horizontal": "npx remotion render remotion/index.ts ShortVideoHorizontal out/video-horizontal.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.509",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remotion": "^4.0.509"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "4.1.10",
    "@types/better-sqlite3": "7.6.13"
  },
  "type": "module"
}
